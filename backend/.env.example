# 复制为 backend/.env 后按需修改；应用与 docker compose 启动时都会自动加载（已导出的环境变量优先）
POSTGRES_USER=ledger
POSTGRES_PASSWORD=change-me-in-local-dev
POSTGRES_DB=ledger
# 与上面的 POSTGRES_* 保持一致；密码含特殊字符时需 URL 编码
DATABASE_URL=postgresql+psycopg://ledger:change-me-in-local-dev@localhost:5432/ledger

APP_TIMEZONE=Asia/Shanghai
API_PREFIX=/api/v1

# 鉴权：留空 = 免鉴权（仅允许绑定 127.0.0.1）；填写后除 /health* 外接口都需 Bearer 令牌
# 生成方式示例：python -c "import secrets;print(secrets.token_urlsafe(32))"
API_TOKEN=
# 文档开关：配置 API_TOKEN 时默认关闭；显式 true 时 /docs、/openapi.json 也要求令牌
DOCS_ENABLED=

REFUND_WINDOW_DAYS=7
BUDGET_WARN_BPS=8000
BUDGET_ALERT_BPS=10000
MAX_UPLOAD_BYTES=10485760
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SEED_ON_STARTUP=true
# 本地首次启动可临时开启（生产必须走 alembic upgrade head）
CREATE_SCHEMA_ON_STARTUP=false
LOG_LEVEL=INFO
